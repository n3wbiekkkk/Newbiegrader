# Local development only — fill from authorized private configuration.
# NEVER commit .env. PC production uses root-only /etc/newbiegrader/*.env;
# see deploy/host examples and docs/HOST_DEPLOYMENT.md. Defaults here are local.
SUPABASE_URL=
SUPABASE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://newbiegrader.pages.dev/api/auth/callback
FRONTEND_URL=https://newbiegrader.pages.dev
SESSION_SECRET=
SESSION_SAMESITE=lax
SESSION_SECURE=false
GRADER_CORS_ORIGINS=https://newbiegrader.pages.dev
ADMIN_EMAILS=
# Rate-limit identity: comma-separated IPs/CIDRs (v4/v6) of the immediate
# network PEERS whose X-Forwarded-For / CF-Connecting-IP headers may be
# honored — i.e. your own edge proxy's egress addresses, never addresses
# claimed by clients. Empty (default) = trust no forwarded headers and rate
# limit by socket peer (safe behind an unlisted proxy, but all users then
# share the proxy's peer bucket — per-account limits still apply). Malformed
# entries refuse to boot. Only list proxies that overwrite/append these
# headers themselves; verify the peer range with your provider first.
# GRADER_TRUSTED_PROXY_CIDRS=203.0.113.0/24,2001:db8::/32
# Precedence: a usable X-Forwarded-For chain always wins; CF-Connecting-IP
# is only a fallback when XFF is absent (a proxy that forwards client-set
# CF values must still send a correct XFF chain). List both address families
# if your proxies are dual-stack. Verify the real peer range and header
# behavior with your provider — header trust here cannot prove them.
# judging throughput + fair-use quota (N per window seconds, 0 = disabled)
# leave 0/unset to auto-derive from the container's cgroup (cpu + ram); see
# GET /api/version -> system for the values actually in use
GRADER_JUDGE_WORKERS=0
GRADER_JUDGE_JOBS=0
GRADER_MEMORY_CAP_MB=0
GRADER_QUEUE_MAX=0
GRADER_OVERALL_TIMEOUT=0
GRADER_COMPILE_TIMEOUT=0
GRADER_SUBMIT_QUOTA=60/600
GRADER_RUN_QUOTA=120/600
# Strict network isolation for judged code (public-production mode): when =1,
# executions that cannot create their network namespace are REFUSED with a
# job-level error instead of running with egress. Default 0 keeps dev/CI
# behavior (warn and continue with rlimits). Enable in prod only after
# verifying unshare(CLONE_NEWNET) works on the prod host; requires a
# userns-enabled kernel or equivalent container network controls. Do NOT
# satisfy this by granting CAP_SYS_ADMIN (root-equivalent).
# Boot contract for judge roles (combined/worker): on a Linux+root host the
# worker refuses to boot unless posture is declared — either strict (=1
# above, with a working namespace probe at startup) or explicit risk
# acceptance below. api role never executes code and is exempt. Non-Linux or
# non-root runtimes boot in rlimits-only dev mode with a warning.
GRADER_REQUIRE_NETNS=0
# GRADER_ALLOW_UNISOLATED_JUDGE=1  # explicit non-netns posture; production
# still requires the verified UID/Landlock/seccomp/cgroup controls in host units.
# local = one combined API/worker process; database = coordinated durable queue
# Apply supabase/schema.sql before enabling database mode (no memory fallback).
GRADER_QUEUE_MODE=local
# combined serves HTTP and judges; api serves HTTP only; worker has no HTTP port.
# api/worker require database mode and a stable shared SESSION_SECRET.
GRADER_ROLE=combined
# Local authoring uses problems/. Production uses Supabase metadata together
# with GRADER_FILE_STORAGE=local and verified protected file roots. A missing
# asset fails closed; it never triggers fallback to another backend.
# See docs/migration-supabase.md and docs/making-problems.md before publishing.
GRADER_PROBLEM_SOURCE=local
# GRADER_PROBLEM_BUCKET=judge-assets
# GRADER_PROBLEM_CACHE_TTL=30
# Processes sharing one resource allocation share its capacity directory.
# The PC worker instances have separate allocations and capacity/worker-N paths;
# their append-only sandbox UID ledger remains shared.
# Containers sharing a CPU/RAM allocation must mount the same directory here.
# GRADER_CAPACITY_DIR=/var/run/newbiegrader-capacity

# Public/publishable Supabase key used only by the stateless email-proof adapter.
# Keep SMTP App Password in Supabase's dashboard, never in the judge container.
# Enable OTP templates + apply the reviewed identity migration before deploying.
SUPABASE_AUTH_KEY=

# File-backend selector below is the legacy development/recovery default.
# PC production explicitly sets local; metadata/auth/queue remain Supabase.
# Do not enable local reads before checksum/permission/backup verification.
GRADER_FILE_STORAGE=supabase
# GRADER_PUBLIC_FILE_ROOT=/var/lib/newbiegrader/public-files
# GRADER_PRIVATE_FILE_ROOT=/var/lib/newbiegrader/private-files
# GRADER_FILE_MIN_FREE_MB=1024
