# Local dev only — copy to .env and fill from the justrunmy panel / Supabase /
# Google console. NEVER commit .env (gitignored). Production uses host env.
SUPABASE_URL=
SUPABASE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://newbiegrader.pages.dev/api/auth/callback
FRONTEND_URL=https://newbiegrader.pages.dev
SESSION_SECRET=
SESSION_SAMESITE=lax
SESSION_SECURE=false
GRADER_CORS_ORIGINS=https://newbiegrader.pages.dev
ADMIN_EMAILS=
# judging throughput + fair-use quota (N per window seconds, 0 = disabled)
# leave 0/unset to auto-derive from the container's cgroup (cpu + ram); see
# GET /api/version -> system for the values actually in use
GRADER_JUDGE_WORKERS=0
GRADER_JUDGE_JOBS=0
GRADER_MEMORY_CAP_MB=0
GRADER_QUEUE_MAX=0
GRADER_OVERALL_TIMEOUT=0
GRADER_COMPILE_TIMEOUT=0
GRADER_SUBMIT_QUOTA=60/600
GRADER_RUN_QUOTA=120/600
# local = one combined API/worker process; database = coordinated durable queue
# Apply supabase/schema.sql before enabling database mode (no memory fallback).
GRADER_QUEUE_MODE=local
# combined serves HTTP and judges; api serves HTTP only; worker has no HTTP port.
# api/worker require database mode and a stable shared SESSION_SECRET.
GRADER_ROLE=combined
# Processes on the same host must share the capacity directory and limit settings.
# Containers sharing a CPU/RAM allocation must mount the same directory here.
# GRADER_CAPACITY_DIR=/var/run/newbiegrader-capacity
