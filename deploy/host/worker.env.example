# Example for worker instance 1; copy to worker-1.env through worker-4.env,
# replacing both worker@1 and capacity/worker-1 for each instance.
# Root:root 0600. Copy existing SUPABASE_URL, SUPABASE_KEY and SESSION_SECRET
# through private SSH. No OAuth client secret or SMTP credential.
GRADER_ROLE=worker
GRADER_QUEUE_MODE=database
GRADER_PROBLEM_SOURCE=supabase
GRADER_ACCEPT_JOBS=0
GRADER_MEMORY_CAP_MB=128
GRADER_JUDGE_WORKERS=1
GRADER_QUEUE_MAX=50
GRADER_OVERALL_TIMEOUT=240
GRADER_REQUIRE_JOB_CGROUP=1
GRADER_CGROUP_ROOT=/sys/fs/cgroup/newbiegrader.slice/newbiegrader-judge.slice/newbiegrader-worker@1.service
GRADER_JOB_CGROUP_ROOT=/sys/fs/cgroup/newbiegrader.slice/newbiegrader-judge.slice/newbiegrader-worker@1.service
GRADER_JOB_MEMORY_MB=640
GRADER_JOB_PIDS=64
GRADER_JOB_CPU_QUOTA_US=100000
GRADER_WORKSPACE_ROOT=/var/lib/newbiegrader/workspaces
GRADER_SANDBOX_IDENTITY_DIR=/var/lib/newbiegrader/sandbox-identities
GRADER_CAPACITY_DIR=/var/lib/newbiegrader/capacity/worker-1
TMPDIR=/var/lib/newbiegrader/workspaces
# Network endpoint denial is enforced by mandatory seccomp, tested by the native host canaries.
# No CAP_SYS_ADMIN/unshare namespace privilege is granted. This legacy flag
# acknowledges missing netns; it does not disable Landlock/seccomp/cgroups.
GRADER_REQUIRE_NETNS=0
GRADER_ALLOW_UNISOLATED_JUDGE=1
PYTHONDONTWRITEBYTECODE=1

# After approved and verified backend-file migration (no Storage fallback):
# GRADER_FILE_STORAGE=local
# GRADER_PUBLIC_FILE_ROOT=/var/lib/newbiegrader/public-files
# GRADER_PRIVATE_FILE_ROOT=/var/lib/newbiegrader/private-files
# GRADER_FILE_MIN_FREE_MB=1024
