# Copy through the approved private SSH transfer, not Git. Root:root 0600.
# Reuse existing values for SUPABASE_URL, SUPABASE_KEY, SUPABASE_AUTH_KEY,
# SESSION_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_REDIRECT_URI,
# FRONTEND_URL, ADMIN_EMAILS, SESSION_SAMESITE, SESSION_SECURE and CORS origins.
# Never generate a replacement SESSION_SECRET as part of migration.
GRADER_ROLE=api
GRADER_QUEUE_MODE=database
GRADER_PROBLEM_SOURCE=supabase
GRADER_ACCEPT_JOBS=0
GRADER_MEMORY_CAP_MB=128
GRADER_JUDGE_WORKERS=1
GRADER_QUEUE_MAX=25
GRADER_OVERALL_TIMEOUT=240
GRADER_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
PYTHONDONTWRITEBYTECODE=1
