# Install only during an approved cutover. Do not replace the health-only
# staging listener before verifying the Worker shared-key gate and VPC binding.
server {
    listen 127.0.0.1:8081;
    server_name _;
    server_tokens off;
    client_max_body_size 1m;
    client_body_timeout 15s;
    access_log off;
    error_log syslog:server=unix:/dev/log warn;
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_set_header Host newbiegrader.pages.dev;
        proxy_set_header X-Forwarded-Proto https;
        # This loopback listener is reached only by the approved private VPC
        # Service. The bridge authenticates Pages and strips the shared key.
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Real-IP "";
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header Connection "";
    }
    location / { return 404; }
}
