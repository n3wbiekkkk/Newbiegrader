{
  "name": "newbiegrader-aws-staging",
  "main": "worker.js",
  "compatibility_date": "2026-10-18",
  // Pages calls this Worker through a service binding. No public Worker route.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": { "API_ENABLED": "0" },
  // Replace only after the operator approves Cloudflare authentication/setup.
  // Register the service for localhost:8080 (health-only), never the network.
  "vpc_services": [
    { "binding": "PRIVATE_API", "service_id": "REPLACE_WITH_HEALTH_ONLY_VPC_SERVICE_ID" }
  ]
}
