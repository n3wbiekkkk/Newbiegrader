[Unit]
Description=Newbiegrader loopback API health probe
After=newbiegrader-api.service

[Service]
Type=oneshot
User=newbiegrader-api
ExecStart=/usr/bin/curl --fail --silent --output /dev/null --max-time 5 http://127.0.0.1:8000/api/health
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
